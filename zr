#!/usr/bin/env zsh

typeset -gr ZR_SCRIPT=${0:A}
typeset -gr ZR_EMBEDDED_BEGIN='# region: zr'
typeset -gr ZR_EMBEDDED_END='# endregion: zr'
typeset -gr ZR_EMBEDDED_LEGACY_BEGIN='# zr:embedded:begin'
typeset -gr ZR_EMBEDDED_LEGACY_END='# zr:embedded:end'
typeset -gr ZR_VERSION=0.1.0
typeset -gr ZR_LICENSE_URL='https://github.com/prfxn/zr/blob/main/LICENSE'

zr::die() {
  print -ru2 -- "zr: $*"
  exit 1
}

zr::valid-name() {
  [[ ${1-} =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]]
}

zr::valid-function-name() {
  [[ ${1-} =~ '^[A-Za-z_][A-Za-z0-9_:]*$' ]]
}

zr::valid-config-function-name() {
  zr::valid-function-name "$1" && [[ $1 != zr::* ]]
}

zr::init-entrypoints() {
  if [[ ${1-} == preserve ]]; then
    typeset -g ZR_MAIN=${ZR_MAIN:-main}
    typeset -g ZR_CONFIGURE=${ZR_CONFIGURE:-configure}
  else
    typeset -g ZR_MAIN=main
    typeset -g ZR_CONFIGURE=configure
  fi
  typeset -gi ZR_CONFIG_CONFIGURE_SET=0
}

zr::main() {
  (( $# == 0 )) || { print -ru2 -- "zr: zr::main takes no arguments"; return 1; }
  print -r -- "$ZR_MAIN"
}

zr::configure() {
  (( $# == 0 )) || { print -ru2 -- "zr: zr::configure takes no arguments"; return 1; }
  print -r -- "$ZR_CONFIGURE"
}

zr::ready() {
  (( ARGC == 0 )) || { print -ru2 -- "zr: zr::ready takes no arguments"; return 1; }
  (( _ZR_READY ))
}

zr::set-main() {
  local name=${1-}
  (( $# == 1 )) || zr::die "zr::set-main requires one argument"
  zr::valid-config-function-name "$name" || zr::die "invalid main function name: $name"
  ZR_MAIN=$name
}

zr::set-configure() {
  local name=${1-}
  (( $# == 1 )) || zr::die "zr::set-configure requires one argument"
  zr::valid-config-function-name "$name" || zr::die "invalid configure function name: $name"
  ZR_CONFIGURE=$name
  ZR_CONFIG_CONFIGURE_SET=1
}

zr::init-state() {
  zr::init-entrypoints "$@"

  typeset -ga ZR_TAGS
  typeset -ga ZR_FILENAME_TAGS
  typeset -ga ZR_CLI_TAGS
  typeset -ga ZR_KNOWN_TAGS
  typeset -gA ZR_PROPS
  typeset -gA ZR_ARGS
  typeset -ga _ZR_REJECTED_ARGS
  typeset -gi _ZR_READY
  ZR_TAGS=()
  ZR_FILENAME_TAGS=()
  ZR_CLI_TAGS=()
  ZR_KNOWN_TAGS=()
  ZR_PROPS=()
  ZR_ARGS=()
  _ZR_REJECTED_ARGS=()
  _ZR_READY=0

  typeset -gA ZR_SCHEMA_TAGS
  typeset -gA ZR_SCHEMA_PROPS
  typeset -gA ZR_SCHEMA_PROP_MODES
  typeset -gA ZR_SCHEMA_PROP_PATTERNS
  typeset -gA ZR_SCHEMA_PROP_VALIDATORS
  typeset -ga ZR_SCHEMA_ARGS
  typeset -gA ZR_SCHEMA_ARG_KINDS
  typeset -ga ZR_SCHEMA_GROUPS
  typeset -ga ZR_SCHEMA_GROUP_TAG_GROUPS
  typeset -ga ZR_SCHEMA_GROUP_TAG_VALUES
  typeset -ga ZR_SCHEMA_VALUE_PROPS
  typeset -ga ZR_SCHEMA_VALUE_VALUES

  zr::reset-schema
}

zr::reset-schema() {
  ZR_SCHEMA_TAGS=()
  ZR_SCHEMA_PROPS=()
  ZR_SCHEMA_PROP_MODES=()
  ZR_SCHEMA_PROP_PATTERNS=()
  ZR_SCHEMA_PROP_VALIDATORS=()
  ZR_SCHEMA_ARGS=()
  ZR_SCHEMA_ARG_KINDS=()
  ZR_SCHEMA_GROUPS=()
  ZR_SCHEMA_GROUP_TAG_GROUPS=()
  ZR_SCHEMA_GROUP_TAG_VALUES=()
  ZR_SCHEMA_VALUE_PROPS=()
  ZR_SCHEMA_VALUE_VALUES=()
  zr::classify-tags
}

zr::has-tag() {
  local wanted=${1-}
  local tag
  for tag in "${ZR_TAGS[@]}"; do
    [[ $tag == "$wanted" ]] && return 0
  done
  return 1
}

zr::has-prop() {
  local name=${1-}
  (( ${+ZR_PROPS[$name]} ))
}

zr::get() {
  local name=${1-}
  if (( ${+ZR_PROPS[$name]} )); then
    print -r -- "${ZR_PROPS[$name]}"
    return 0
  fi
  return 1
}

zr::get-arg() {
  local name=${1-}
  if (( ${+ZR_ARGS[$name]} )); then
    print -r -- "${ZR_ARGS[$name]}"
    return 0
  fi
  return 1
}

zr::tag() {
  (( $# == 1 )) || { print -ru2 -- "zr: zr::tag requires one argument"; return 1; }
  ZR_SCHEMA_TAGS[$1]=1
  zr::classify-tags
}

zr::tag-group() {
  local group=${1-}
  shift || true

  zr::valid-name "$group" || { print -ru2 -- "zr: invalid tag group name: $group"; return 1; }
  (( $# > 0 )) || { print -ru2 -- "zr: tag group '$group' has no tags"; return 1; }
  (( ${ZR_SCHEMA_GROUPS[(Ie)$group]} == 0 )) || { print -ru2 -- "zr: duplicate tag group: $group"; return 1; }
  (( ! ${+ZR_SCHEMA_PROPS[$group]} )) || { print -ru2 -- "zr: tag group collides with property: $group"; return 1; }
  (( ${ZR_SCHEMA_ARGS[(Ie)$group]} == 0 )) || { print -ru2 -- "zr: tag group collides with argument: $group"; return 1; }

  ZR_SCHEMA_GROUPS+=("$group")

  local tag
  for tag in "$@"; do
    ZR_SCHEMA_TAGS[$tag]=1
    ZR_SCHEMA_GROUP_TAG_GROUPS+=("$group")
    ZR_SCHEMA_GROUP_TAG_VALUES+=("$tag")
  done
  zr::classify-tags
}

zr::prop() {
  local name=${1-}
  (( $# == 1 )) || { print -ru2 -- "zr: zr::prop requires one argument"; return 1; }
  zr::valid-name "$name" || { print -ru2 -- "zr: invalid property name: $name"; return 1; }
  (( ${ZR_SCHEMA_GROUPS[(Ie)$name]} == 0 )) || { print -ru2 -- "zr: property collides with tag group: $name"; return 1; }
  (( ${ZR_SCHEMA_ARGS[(Ie)$name]} == 0 )) || { print -ru2 -- "zr: property collides with argument: $name"; return 1; }
  ZR_SCHEMA_PROPS[$name]=1
}

zr::declare-arg() {
  local api=$1 kind=$2 name=$3
  (( $# == 3 )) || { print -ru2 -- "zr: zr::$api requires one argument"; return 1; }
  zr::valid-name "$name" || { print -ru2 -- "zr: invalid argument name: $name"; return 1; }
  (( ${ZR_SCHEMA_ARGS[(Ie)$name]} == 0 )) || { print -ru2 -- "zr: duplicate argument: $name"; return 1; }
  (( ! ${+ZR_SCHEMA_PROPS[$name]} )) || { print -ru2 -- "zr: argument collides with property: $name"; return 1; }
  (( ${ZR_SCHEMA_GROUPS[(Ie)$name]} == 0 )) || { print -ru2 -- "zr: argument collides with tag group: $name"; return 1; }

  ZR_SCHEMA_ARGS+=("$name")
  ZR_SCHEMA_ARG_KINDS[$name]=$kind
  zr::classify-tags
}

zr::arg() {
  (( $# == 1 )) || { print -ru2 -- "zr: zr::arg requires one argument"; return 1; }
  zr::declare-arg arg arg "$1"
}

zr::path-arg() {
  (( $# == 1 )) || { print -ru2 -- "zr: zr::path-arg requires one argument"; return 1; }
  zr::declare-arg path-arg path "$1"
}

zr::set-prop-mode() {
  local name=$1 mode=$2 api=$3
  local current=${ZR_SCHEMA_PROP_MODES[$name]-}
  if [[ -n $current && $current != "$mode" ]]; then
    print -ru2 -- "zr: property '$name' cannot combine zr::$current with zr::$api"
    return 1
  fi
  ZR_SCHEMA_PROP_MODES[$name]=$mode
}

zr::values() {
  local name=${1-}
  shift || true
  zr::valid-name "$name" || { print -ru2 -- "zr: invalid property name: $name"; return 1; }
  zr::set-prop-mode "$name" values values || return 1

  local value
  for value in "$@"; do
    ZR_SCHEMA_VALUE_PROPS+=("$name")
    ZR_SCHEMA_VALUE_VALUES+=("$value")
  done
}

zr::pattern() {
  local name=${1-} pattern=${2-}
  (( $# == 2 )) || { print -ru2 -- "zr: zr::pattern requires property name and pattern"; return 1; }
  zr::valid-name "$name" || { print -ru2 -- "zr: invalid property name: $name"; return 1; }
  zr::set-prop-mode "$name" pattern pattern || return 1
  ZR_SCHEMA_PROP_PATTERNS[$name]=$pattern
}

zr::validate() {
  local name=${1-} validator=${2-}
  (( $# == 2 )) || { print -ru2 -- "zr: zr::validate requires property name and function"; return 1; }
  zr::valid-name "$name" || { print -ru2 -- "zr: invalid property name: $name"; return 1; }
  [[ -n $validator ]] || { print -ru2 -- "zr: missing validator function name"; return 1; }
  zr::set-prop-mode "$name" validate validate || return 1
  ZR_SCHEMA_PROP_VALIDATORS[$name]=$validator
}

zr::props-to-env() {
  local -a names
  local name
  if (( $# )); then
    names=("$@")
  else
    names=("${(@k)ZR_PROPS}")
  fi

  for name in "${names[@]}"; do
    zr::valid-name "$name" || { print -ru2 -- "zr: invalid property name: $name"; return 1; }
    (( ${+ZR_PROPS[$name]} )) || continue
    typeset -g "${name}=${ZR_PROPS[$name]}"
  done
}

zr::active-tag-for-group() {
  local group=$1
  local i tag active=
  for (( i = 1; i <= ${#ZR_SCHEMA_GROUP_TAG_GROUPS[@]}; i++ )); do
    [[ ${ZR_SCHEMA_GROUP_TAG_GROUPS[$i]} == "$group" ]] || continue
    tag=${ZR_SCHEMA_GROUP_TAG_VALUES[$i]}
    if zr::has-tag "$tag"; then
      [[ -z $active ]] || return 2
      active=$tag
    fi
  done
  [[ -n $active ]] || return 1
  print -r -- "$active"
}

zr::has-tag-for-group() {
  local _active
  _active=$(zr::active-tag-for-group "$1")
}

zr::tag-groups-to-env() {
  local -a groups
  local group active
  if (( $# )); then
    groups=("$@")
  else
    groups=("${ZR_SCHEMA_GROUPS[@]}")
  fi

  for group in "${groups[@]}"; do
    zr::valid-name "$group" || { print -ru2 -- "zr: invalid tag group name: $group"; return 1; }
    active=$(zr::active-tag-for-group "$group") || continue
    typeset -g "${group}=${active}"
  done
}

zr::add-tag() {
  local tag=$1
  (( ${ZR_TAGS[(Ie)$tag]} == 0 )) && ZR_TAGS+=("$tag")
}

zr::add-known-tag() {
  local tag=$1
  (( ${ZR_KNOWN_TAGS[(Ie)$tag]} == 0 )) && ZR_KNOWN_TAGS+=("$tag")
}

zr::classify-tags() {
  local tag arg_index arg_name
  ZR_TAGS=()
  ZR_KNOWN_TAGS=()
  ZR_ARGS=()
  _ZR_REJECTED_ARGS=()
  for tag in "${ZR_FILENAME_TAGS[@]}"; do
    zr::add-tag "$tag"
    zr::add-known-tag "$tag"
  done
  arg_index=1
  for tag in "${ZR_CLI_TAGS[@]}"; do
    if (( ${+ZR_SCHEMA_TAGS[$tag]} )); then
      zr::add-tag "$tag"
      zr::add-known-tag "$tag"
    elif (( arg_index <= ${#ZR_SCHEMA_ARGS[@]} )); then
      arg_name=${ZR_SCHEMA_ARGS[$arg_index]}
      ZR_ARGS[$arg_name]=$tag
      (( arg_index++ ))
    else
      _ZR_REJECTED_ARGS+=("$tag")
    fi
  done
}

zr::filename-tags() {
  local config_name=$1
  local base=${config_name:t}
  local -a parts
  parts=("${(@s:.:)base}")

  local part
  for part in "${parts[@]}"; do
    if [[ -n $part ]]; then
      (( ${ZR_FILENAME_TAGS[(Ie)$part]} == 0 )) && ZR_FILENAME_TAGS+=("$part")
      zr::classify-tags
    fi
  done
}

zr::parse-args() {
  local arg name value
  typeset -ga ZR_MAIN_ARGS
  ZR_MAIN_ARGS=()

  while (( $# )); do
    arg=$1
    shift

    if [[ $arg == -- ]]; then
      ZR_MAIN_ARGS=("$@")
      return 0
    fi

    if [[ $arg == *=* ]]; then
      name=${arg%%=*}
      value=${arg#*=}
      if zr::valid-name "$name"; then
        (( ! ${+ZR_PROPS[$name]} )) || zr::die "property supplied more than once: $name"
        ZR_PROPS[$name]=$value
      else
        ZR_CLI_TAGS+=("$arg")
        zr::add-tag "$arg"
      fi
    else
      ZR_CLI_TAGS+=("$arg")
      zr::add-tag "$arg"
    fi
  done
}

zr::property-has-values() {
  local name=$1
  local prop
  for prop in "${ZR_SCHEMA_VALUE_PROPS[@]}"; do
    [[ $prop == "$name" ]] && return 0
  done
  return 1
}

zr::property-value-valid() {
  local name=$1 value=$2
  local i
  for (( i = 1; i <= ${#ZR_SCHEMA_VALUE_PROPS[@]}; i++ )); do
    [[ ${ZR_SCHEMA_VALUE_PROPS[$i]} == "$name" ]] || continue
    [[ ${ZR_SCHEMA_VALUE_VALUES[$i]} == "$value" ]] && return 0
  done
  return 1
}

zr::validate-state() {
  local tag name group active value mode validator

  zr::classify-tags
  for tag in "${_ZR_REJECTED_ARGS[@]}"; do
    zr::die "argument not accepted by config: $tag"
  done

  for name in "${(@k)ZR_PROPS}"; do
    (( ${+ZR_SCHEMA_PROPS[$name]} )) || zr::die "property not accepted by config: $name"
    value=${ZR_PROPS[$name]}
    mode=${ZR_SCHEMA_PROP_MODES[$name]-}
    case $mode in
      values)
        zr::property-value-valid "$name" "$value" || zr::die "invalid value for property '$name': $value"
        ;;
      pattern)
        [[ $value =~ ${ZR_SCHEMA_PROP_PATTERNS[$name]} ]] || zr::die "invalid value for property '$name': $value"
        ;;
      validate)
        validator=${ZR_SCHEMA_PROP_VALIDATORS[$name]}
        (( $+functions[$validator] )) || zr::die "validator for property '$name' is not defined: $validator"
        "$validator" "$value" "$name" || zr::die "invalid value for property '$name': $value"
        ;;
      "")
        ;;
      *)
        zr::die "unknown validation mode for property '$name': $mode"
        ;;
    esac
  done

  for group in "${ZR_SCHEMA_GROUPS[@]}"; do
    active=$(zr::active-tag-for-group "$group")
    case $? in
      0|1) ;;
      2) zr::die "multiple tags supplied for group '$group'" ;;
      *) zr::die "could not validate tag group '$group'" ;;
    esac
  done
}

zr::resolve-config() {
  local config_name=$1
  if [[ $config_name == */* ]]; then
    print -r -- "$config_name"
  else
    command -v -- "$config_name" 2>/dev/null || print -r -- "$config_name"
  fi
}

zr::configure-is-required() {
  [[ ${ZR_CONFIGURE:-configure} != configure ]] || (( ZR_CONFIG_CONFIGURE_SET ))
}

zr::run-configure() {
  local configure_fn=${ZR_CONFIGURE:-configure}
  zr::valid-config-function-name "$configure_fn" || zr::die "invalid configure function name: $configure_fn"
  if (( $+functions[$configure_fn] )); then
    zr::reset-schema
    "$configure_fn" || zr::die "$configure_fn() failed"
    return 0
  fi
  zr::configure-is-required && zr::die "config does not define $configure_fn()"
  return 1
}

zr::run-loaded-config() {
  local main_fn=${ZR_MAIN:-main}
  zr::valid-config-function-name "$main_fn" || zr::die "invalid main function name: $main_fn"
  (( $+functions[$main_fn] )) || zr::die "config does not define $main_fn()"

  if zr::run-configure; then
    zr::validate-state
  fi

  _ZR_READY=1
  "$main_fn" "${ZR_MAIN_ARGS[@]}"
}

zr::next-arg-kind() {
  local next=$(( ${#ZR_ARGS[@]} + 1 ))
  local name
  (( next <= ${#ZR_SCHEMA_ARGS[@]} )) || return 1
  name=${ZR_SCHEMA_ARGS[$next]}
  print -r -- "${ZR_SCHEMA_ARG_KINDS[$name]}"
}

zr::tag-blocked-by-active-group() {
  local candidate=$1
  local i j group tag
  for (( i = 1; i <= ${#ZR_SCHEMA_GROUP_TAG_GROUPS[@]}; i++ )); do
    [[ ${ZR_SCHEMA_GROUP_TAG_VALUES[$i]} == "$candidate" ]] || continue
    group=${ZR_SCHEMA_GROUP_TAG_GROUPS[$i]}
    for tag in "${ZR_TAGS[@]}"; do
      for (( j = 1; j <= ${#ZR_SCHEMA_GROUP_TAG_GROUPS[@]}; j++ )); do
        [[ ${ZR_SCHEMA_GROUP_TAG_GROUPS[$j]} == "$group" ]] || continue
        [[ ${ZR_SCHEMA_GROUP_TAG_VALUES[$j]} == "$tag" ]] && return 0
      done
    done
  done
  return 1
}

zr::complete-loaded() {
  local config_lexical=$1 current=$2
  shift 2
  zr::filename-tags "$config_lexical"
  zr::parse-args "$@"

  local configure_fn=${ZR_CONFIGURE:-configure}
  zr::valid-config-function-name "$configure_fn" || return 1
  if (( ! $+functions[$configure_fn] )); then
    zr::configure-is-required && return 1
    return 0
  fi

  zr::reset-schema
  "$configure_fn" || return 1

  local name value tag prop i
  if [[ $current == *=* ]]; then
    name=${current%%=*}
    value=${current#*=}
    if zr::valid-name "$name"; then
      for (( i = 1; i <= ${#ZR_SCHEMA_VALUE_PROPS[@]}; i++ )); do
        [[ ${ZR_SCHEMA_VALUE_PROPS[$i]} == "$name" ]] || continue
        [[ ${ZR_SCHEMA_VALUE_VALUES[$i]} == "$value"* ]] || continue
        print -r -- "${name}=${ZR_SCHEMA_VALUE_VALUES[$i]}"
      done
      return 0
    fi
  fi

  for tag in "${(@k)ZR_SCHEMA_TAGS}"; do
    (( ${ZR_TAGS[(Ie)$tag]} == 0 )) || continue
    zr::tag-blocked-by-active-group "$tag" && continue
    [[ $tag == "$current"* ]] && print -r -- "$tag"
  done

  for prop in "${(@k)ZR_SCHEMA_PROPS}"; do
    (( ${+ZR_PROPS[$prop]} )) && continue
    [[ $prop == "$current"* ]] && print -r -- "${prop}="
  done

  if [[ $(zr::next-arg-kind 2>/dev/null) == path ]]; then
    print -r -- "__ZR_COMPLETE_FILES__"
  fi
}

zr::complete-external() {
  (( $# >= 1 )) || return 1

  local config_lexical=$1 lexical= current=
  shift
  lexical=$config_lexical

  while (( $# )); do
    case $1 in
      --_zr-lexical)
        shift
        lexical=${1-}
        shift || true
        ;;
      --current)
        shift
        current=${1-}
        shift || true
        break
        ;;
      *)
        break
        ;;
    esac
  done

  local config_path
  config_path=$(zr::resolve-config "$config_lexical") || return 1
  [[ -r $config_path ]] || return 1

  source "$config_path" || return 1
  zr::complete-loaded "$lexical" "$current" "$@"
}

zr::complete-embedded() {
  local lexical=${ZR_SCRIPT:t} current=
  while (( $# )); do
    case $1 in
      --_zr-lexical)
        shift
        lexical=${1-}
        shift || true
        ;;
      --current)
        shift
        current=${1-}
        shift || true
        break
        ;;
      *)
        break
        ;;
    esac
  done

  zr::complete-loaded "$lexical" "$current" "$@"
}

zr::completion-function-name() {
  local command_name=${1:t}
  command_name=${command_name//[^A-Za-z0-9_.:-]/_}
  print -r -- "_$command_name"
}

zr::print-completion() {
  local mode=${1:-source} command_name=${2:-zr} kind=${3:-external}
  local function_name runner=$ZR_SCRIPT
  function_name=$(zr::completion-function-name "$command_name")
  if [[ $mode == autoload ]]; then
    print -r -- "#compdef $command_name"
    print -r -- ""
  fi
  print -r -- "$function_name() {"
  print -r -- "  local config start current cmd runner lexical"
  print -r -- "  local completion_kind=${(qqq)kind}"
  print -r -- "  local external_runner=${(qqq)runner}"
  cat <<'ZR_COMPLETION'

  cmd=${words[1]}
  lexical=$cmd

  if [[ $completion_kind == external ]]; then
    if (( CURRENT == 2 )); then
      _files
      return
    fi
    if [[ ${cmd:t} == zr ]]; then
      config=${(Q)words[2]}
      start=3
    else
      config=${(Q)words[1]}
      start=2
    fi
    runner=$external_runner
  else
    config=${(Q)words[1]}
    start=2
    if [[ $cmd == */* ]]; then
      runner=$cmd
    else
      runner=${commands[$cmd]:-$cmd}
    fi
  fi

  [[ -n $config ]] || return
  current=${(Q)words[CURRENT]}

  local -a committed candidates spaced nospace
  committed=("${(@Q)words[$start,$(( CURRENT - 1 ))]}")
  if [[ $completion_kind == external ]]; then
    candidates=("${(@f)$("$runner" --_zr-complete "$config" --_zr-lexical "$lexical" --current "$current" "${committed[@]}" 2>/dev/null)}")
  else
    candidates=("${(@f)$("$runner" --_zr-complete --_zr-lexical "$lexical" --current "$current" "${committed[@]}" 2>/dev/null)}")
  fi

  (( ${#candidates[@]} )) || return

  local candidate complete_files=0
  for candidate in "${candidates[@]}"; do
    if [[ $candidate == __ZR_COMPLETE_FILES__ ]]; then
      complete_files=1
      continue
    fi
    if [[ $candidate == *= ]]; then
      nospace+=("$candidate")
    else
      spaced+=("$candidate")
    fi
  done

  local added=1
  (( ${#nospace[@]} )) && compadd -S "" -a nospace && added=0
  (( ${#spaced[@]} )) && compadd -a spaced && added=0
  (( complete_files )) && _files && added=0
  (( added == 0 )) && _compskip=all
  return $added
}
ZR_COMPLETION

  if [[ $mode == source ]]; then
    print -r -- "compdef $function_name $command_name"
    print -r -- "compdef $function_name -p '*/$command_name(|.*)'"
  else
    print -r -- ""
    print -r -- "compdef $function_name -p '*/$command_name(|.*)'"
    print -r -- "$function_name \"\$@\""
  fi
}

zr::print-embedded-runtime() {
  print -r -- "$ZR_EMBEDDED_BEGIN, version=$ZR_VERSION, license-url=$ZR_LICENSE_URL"
  print -r -- '# SPDX-License-Identifier: MIT'
  print -r -- '# SPDX-FileCopyrightText: 2026 prfxn'

  local first=1 line
  while IFS= read -r line || [[ -n $line ]]; do
    if (( first )); then
      first=0
      [[ $line == '#!'* ]] && continue
    fi

    if [[ $line == 'zr::_main "$@"' ]]; then
      print -r -- 'zr::_embedded-main "$@"'
    else
      print -r -- "$line"
    fi
  done < "$ZR_SCRIPT"

  print -r -- "$ZR_EMBEDDED_END"
}

zr::embed() {
  (( $# == 1 )) || zr::die "zr --embed requires one config operand"

  local config=$1
  [[ -r $config ]] || zr::die "config cannot be read: $config"

  local line first=1 saw_begin=0 saw_end=0 in_region=0
  local emitted_shebang=0 replaced=0

  while IFS= read -r line || [[ -n $line ]]; do
    if (( first )); then
      first=0
      if [[ $line == '#!'* ]]; then
        print -r -- '#!/usr/bin/env zsh'
        emitted_shebang=1
        continue
      fi
    fi

    if [[ $line == "$ZR_EMBEDDED_BEGIN"* || $line == "$ZR_EMBEDDED_LEGACY_BEGIN"* ]]; then
      (( saw_begin )) && zr::die "malformed embedded region: duplicate begin marker"
      saw_begin=1
      in_region=1
      replaced=1
      zr::print-embedded-runtime
      continue
    fi

    if [[ $line == "$ZR_EMBEDDED_END"* || $line == "$ZR_EMBEDDED_LEGACY_END"* ]]; then
      (( saw_begin )) || zr::die "malformed embedded region: end marker without begin marker"
      in_region=0
      saw_end=1
      continue
    fi

    (( in_region )) && continue

    if (( ! emitted_shebang )); then
      print -r -- '#!/usr/bin/env zsh'
      emitted_shebang=1
    fi
    print -r -- "$line"
  done < "$config"

  (( in_region )) && zr::die "malformed embedded region: begin marker without end marker"
  (( saw_begin && ! saw_end )) && zr::die "malformed embedded region: begin marker without end marker"

  if (( ! replaced )); then
    print -r -- ""
    zr::print-embedded-runtime
  fi
}

zr::_embedded-main() {
  case ${1-} in
    --completion)
      zr::print-completion source "${ZR_SCRIPT:t}" embedded
      return 0
      ;;
    --completion-autoload)
      zr::print-completion autoload "${ZR_SCRIPT:t}" embedded
      return 0
      ;;
    --_zr-complete)
      shift
      zr::init-state preserve
      zr::complete-embedded "$@"
      return $?
      ;;
  esac

  zr::init-state preserve
  zr::filename-tags "${ZR_SCRIPT:t}"
  zr::parse-args "$@"
  zr::run-loaded-config
}

zr::_main() {
  case ${1-} in
    --embed)
      shift
      zr::embed "$@"
      return 0
      ;;
    --completion)
      zr::print-completion source zr external
      return 0
      ;;
    --completion-autoload)
      zr::print-completion autoload zr external
      return 0
      ;;
    --_zr-complete)
      shift
      zr::init-state
      zr::complete-external "$@"
      return $?
      ;;
  esac

  (( $# >= 1 )) || zr::die "missing config operand"

  zr::init-state

  local config_lexical=$1
  shift

  case ${1-} in
    --completion)
      zr::print-completion source "${config_lexical:t}" external
      return 0
      ;;
    --completion-autoload)
      zr::print-completion autoload "${config_lexical:t}" external
      return 0
      ;;
  esac

  zr::filename-tags "$config_lexical"
  zr::parse-args "$@"

  local config_path
  config_path=$(zr::resolve-config "$config_lexical") || zr::die "config not found: $config_lexical"
  [[ -r $config_path ]] || zr::die "config cannot be read: $config_lexical"

  source "$config_path" || zr::die "failed to source config: $config_lexical"

  zr::run-loaded-config
}

zr::_main "$@"
